# Copy this file to .env (next to pyproject.toml) and fill in your keys. Never commit .env.
# A setting the plugins' first-run setup or a download's installer saved in autopilot.env (in the user settings folder,
# e.g. %LOCALAPPDATA%\Autopilot\) wins over this file: see "Configuration" in CONTRIBUTING.md.

# Jev, the decision model that plays the game (https://typesafe.ai)
TYPESAFE_API_KEY=

# The language model that researches the game and writes the harness. With the default agent (OpenCode) and its
# default provider, and with Claude Code (AUTOPILOT_AGENT=claude), this is your Anthropic key.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# AUTOPILOT_AGENT=opencode           # opencode (OpenCode), claude (Claude Code) or codex (Codex: OpenAI keys only)
# AUTOPILOT_MODEL=claude-opus-5-5    # the agent's language model
# AUTOPILOT_OPENCODE_PROVIDER=anthropic # OpenCode's provider (e.g. openai, opencode, openrouter, deepseek, google: each reads its own key)
# AUTOPILOT_BUN=                     # Bun's executable, when it isn't on PATH or in ~/.bun/bin
# AUTOPILOT_FAST=1                   # fast mode for Opus models (OpenCode and Claude Code: ~2x faster output, 2x the price); 0 turns it off
# AUTOPILOT_TIMEOUT=1800             # one request's budget, in seconds
# AUTOPILOT_SANDBOX=auto             # where model-written code runs: auto, bwrap, process or off
# AUTOPILOT_MEMORY=                  # where Autopilot keeps what it learns about each game (default: memory/ here)
